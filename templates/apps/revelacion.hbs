<div class="rb-revelacion-interior">

  <header class="rb-revelacion-cabecera">
    <h1>La Revelación</h1>
    <p class="rb-lead">El clímax ocurre cuando alguien pone una explicación en el mundo y acepta sus consecuencias.</p>
    {{#if caso.pregunta}}<p class="rb-pregunta">{{caso.pregunta}}</p>{{/if}}
  </header>

  <section class="rb-panel rb-nucleo">
    <h2>Formular el Núcleo</h2>
    <label>QUÉ OCURRIÓ
      <textarea name="nucleoQue" rows="2" {{disabled (not esGM)}}
        placeholder="El acontecimiento central que explica el caso">{{caso.nucleo.que}}</textarea></label>
    <label>QUIÉN / QUÉ LO PROVOCÓ
      <textarea name="nucleoQuien" rows="2" {{disabled (not esGM)}}
        placeholder="Una persona, grupo, accidente, fenómeno o combinación">{{caso.nucleo.quien}}</textarea></label>
    <label>POR QUÉ
      <textarea name="nucleoPorQue" rows="2" {{disabled (not esGM)}}
        placeholder="El motivo, objetivo o lógica que explica lo ocurrido">{{caso.nucleo.porque}}</textarea></label>
  </section>

  <section class="rb-panel rb-clasificacion">
    <h2>Clasificar todas las Pistas</h2>
    <p class="rb-ayuda">Ninguna puede ignorarse. Señal aporta materialmente; Ruido queda cerrado por un Puente Causal;
      Interferencia puede coexistir pero todavía no sabéis qué significa.</p>

    <div class="rb-revelacion-pistas">
      {{#each filas}}
      <article class="rb-fila-pista rb-clase-{{#if clasificacion}}{{clasificacion}}{{else}}sin{{/if}}" data-id="{{id}}">
        <header>
          <span class="rb-tarjeta-codigo">{{codigo}}</span>
          <p class="rb-fila-texto">{{texto}}</p>
          {{#if dura}}<span class="rb-badge rb-badge-dura">DURA</span>{{/if}}
        </header>
        {{#if fiabilidad}}<p class="rb-tarjeta-fiabilidad">{{fiabilidad}}</p>{{/if}}
        <div class="rb-fila-controles">
          <label class="rb-radio rb-radio-senal">
            <input type="radio" name="pista.{{id}}.clasificacion" value="senal"
                   {{checked (eq clasificacion "senal")}} {{disabled (not ../esGM)}}> SEÑAL</label>
          <label class="rb-radio rb-radio-ruido">
            <input type="radio" name="pista.{{id}}.clasificacion" value="ruido"
                   {{checked (eq clasificacion "ruido")}} {{disabled (not ../esGM)}}> RUIDO</label>
          <label class="rb-radio rb-radio-interferencia">
            <input type="radio" name="pista.{{id}}.clasificacion" value="interferencia"
                   {{checked (eq clasificacion "interferencia")}} {{disabled (not ../esGM)}}> INTERFERENCIA</label>
          <label class="rb-radio rb-radio-sin">
            <input type="radio" name="pista.{{id}}.clasificacion" value=""
                   {{checked (not clasificacion)}} {{disabled (not ../esGM)}}> —</label>
          <select name="pista.{{id}}.ancla" {{disabled (or (not esSenal) (not ../esGM))}}>
            {{selectOptions ../anclasOpciones selected=ancla valueAttr="id" labelAttr="label"}}
          </select>
        </div>
        <input class="rb-fila-justificacion" type="text" name="pista.{{id}}.justificacion"
               value="{{justificacion}}" {{disabled (not ../esGM)}}
               placeholder="Señal: «apoya nuestra teoría porque…» · Ruido: «existe porque… pero pertenece a…»">
      </article>
      {{else}}
      <p class="rb-vacio">No hay Pistas descubiertas todavía.</p>
      {{/each}}
    </div>
  </section>

  <section class="rb-revelacion-marcador">
    <div class="rb-marcador-caja rb-marcador-senal">
      <span class="rb-cifra">{{senales.length}}</span><span class="rb-etiqueta">Señales</span></div>
    <div class="rb-marcador-caja rb-marcador-ruido">
      <span class="rb-cifra">{{ruido.length}}</span><span class="rb-etiqueta">Ruido</span></div>
    <div class="rb-marcador-caja rb-marcador-interferencia">
      <span class="rb-cifra">{{interferencias.length}}</span><span class="rb-etiqueta">Interferencias</span></div>
    <div class="rb-marcador-caja rb-marcador-afinacion">
      <span class="rb-cifra">+{{afinacion}}</span><span class="rb-etiqueta">Afinación</span></div>
  </section>

  <section class="rb-revelacion-estados">
    {{#if control}}<p class="rb-estado rb-estado-control"><i class="fa-solid fa-shield"></i>
      CONTROL · con +3, QUÉ, QUIÉN y POR QUÉ quedan protegidos en un 7-9.</p>{{/if}}
    {{#if mordedura}}<p class="rb-estado rb-estado-mordedura"><i class="fa-solid fa-bolt"></i>
      MORDEDURA · con {{interferencias.length}} Interferencias, cualquier 10+ se convierte en 7-9.</p>{{/if}}
    {{#if anclaObligatoria}}<p class="rb-estado rb-estado-ancla"><i class="fa-solid fa-thumbtack"></i>
      Una sola Interferencia: será el Ancla obligatoria si obtenéis 7-9.</p>{{/if}}
    <ul class="rb-requisitos">
      {{#each requisitos}}
      <li class="{{#if cumplido}}cumplido{{else}}pendiente{{/if}}">
        <i class="fa-solid {{#if cumplido}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{texto}}</li>
      {{/each}}
    </ul>
  </section>

  {{#if bloqueos}}
  <section class="rb-revelacion-bloqueos">
    {{#each bloqueos}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
  </section>
  {{/if}}

  {{#if esGM}}
  <footer class="rb-revelacion-acciones">
    <button type="button" class="rb-boton-revelar" data-action="tirar" {{disabled bloqueos.length}}>
      <i class="fa-solid fa-dice"></i> Revelar · 2d6 +{{afinacion}}</button>
    <span class="rb-acciones-secundarias">
      <button type="button" data-action="retirada"><i class="fa-solid fa-person-walking-arrow-right"></i> Retirada (+1 Ruido)</button>
      <button type="button" data-action="grieta"><i class="fa-solid fa-bolt-lightning"></i> Seguir la Grieta (+2 Ruido)</button>
      <button type="button" data-action="limpiar"><i class="fa-solid fa-eraser"></i> Limpiar clasificación</button>
    </span>
  </footer>
  {{/if}}

</div>
