<div class="rb-revelacion">

  <header class="rb-revelacion-cab">
    <h1>La Revelación</h1>
    <p class="rb-lead">El clímax ocurre cuando alguien pone una explicación en el mundo y acepta sus consecuencias.</p>
  </header>

  <section class="rb-nucleo rb-oscuro">
    <div class="rb-nucleo-campo {{#unless caso.nucleo.que}}vacio{{/unless}}">
      <label>Qué ocurrió</label>
      <textarea rows="2" data-nucleo="que" placeholder="El acontecimiento central que explica el caso">{{caso.nucleo.que}}</textarea>
    </div>
    <div class="rb-nucleo-campo {{#unless caso.nucleo.quien}}vacio{{/unless}}">
      <label>Quién / qué lo provocó</label>
      <textarea rows="2" data-nucleo="quien" placeholder="Una persona, grupo, accidente, fenómeno o combinación">{{caso.nucleo.quien}}</textarea>
    </div>
    <div class="rb-nucleo-campo {{#unless caso.nucleo.porque}}vacio{{/unless}}">
      <label>Por qué</label>
      <textarea rows="2" data-nucleo="porque" placeholder="El motivo, objetivo o lógica que explica lo ocurrido">{{caso.nucleo.porque}}</textarea>
    </div>
  </section>

  <div class="rb-bandejas">
    {{#each bandejas}}
    <section class="rb-bandeja rb-bandeja-{{clase}}" data-bandeja="{{id}}">
      <header class="rb-bandeja-cab"><h2>{{titulo}}</h2><p>{{nota}}</p></header>
      <div class="rb-bandeja-cuerpo">
        {{#each pistas}}
        <article class="rb-ficha-pista rb-papel" data-tipo="ficha-pista" data-id="{{id}}" style="--rb-giro:{{giro}}deg">
          <div class="rb-pista-cab">
            <span class="rb-codigo">{{codigo}}</span>
            {{#if dura}}<span class="rb-marca rb-marca-dura">DURA</span>{{/if}}
            <button type="button" class="rb-boton-icono" data-action="abrirPista" title="Abrir la tarjeta"><i class="fa-solid fa-pen"></i></button>
          </div>
          <p class="rb-pista-texto">{{texto}}</p>
          {{#if fiabilidad}}<p class="rb-pista-fiabilidad">{{fiabilidad}}</p>{{/if}}
          {{#unless (eq ../id "")}}
          <input class="rb-justificacion {{#if faltaJustificacion}}falta{{/if}}" type="text"
                 data-justificacion="{{id}}" value="{{justificacion}}"
                 placeholder="{{#if (eq ../id 'senal')}}Esto apoya nuestra teoría porque…{{else if (eq ../id 'ruido')}}Esto existe porque… pero pertenece a…{{else}}Anotad lo que no encaja{{/if}}">
          {{/unless}}
          {{#if esSenal}}
          <div class="rb-ancla-sel">
            {{#each anclas}}
            <button type="button" class="rb-ancla-btn {{#if activa}}activa{{/if}}" data-action="ancla" data-ancla="{{id}}">{{corto}}</button>
            {{/each}}
          </div>
          {{/if}}
        </article>
        {{else}}
        <p class="rb-vacio">—</p>
        {{/each}}
      </div>
    </section>
    {{/each}}
  </div>

  <section class="rb-marcador">
    <div class="rb-caja-cifra rb-caja-senal"><span class="n">{{senales.length}}</span><span class="t">Señales</span></div>
    <div class="rb-caja-cifra rb-caja-ruido"><span class="n">{{ruido.length}}</span><span class="t">Ruido</span></div>
    <div class="rb-caja-cifra rb-caja-interferencia"><span class="n">{{interferencias.length}}</span><span class="t">Interferencias</span></div>
    <div class="rb-caja-cifra rb-caja-afinacion"><span class="n">+{{afinacion}}</span><span class="t">Afinación</span></div>
    <div class="rb-estados">
      {{#if control}}<p class="rb-estado rb-estado-control"><i class="fa-solid fa-shield"></i> CONTROL · en un 7-9, QUÉ, QUIÉN y POR QUÉ quedan protegidos.</p>{{/if}}
      {{#if mordedura}}<p class="rb-estado rb-estado-mordedura"><i class="fa-solid fa-bolt"></i> MORDEDURA · cualquier 10+ se convierte en 7-9.</p>{{/if}}
      {{#if anclaObligatoria}}<p class="rb-estado rb-estado-ancla"><i class="fa-solid fa-thumbtack"></i> Una sola Interferencia: será el Ancla obligatoria si sale 7-9.</p>{{/if}}
      {{#each requisitos}}
      <p class="rb-requisito {{#if cumplido}}cumplido{{else}}pendiente{{/if}}">
        <i class="fa-solid {{#if cumplido}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{texto}}</p>
      {{/each}}
    </div>
  </section>

  {{#if bloqueos}}
  <section class="rb-bloqueos">
    {{#each bloqueos}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
  </section>
  {{/if}}

  {{#if esGM}}
  <footer class="rb-acciones">
    <button type="button" class="rb-boton-fuerte" data-action="tirar" {{disabled bloqueos.length}}>
      <i class="fa-solid fa-dice"></i> Revelar · 2d6 +{{afinacion}}</button>
    <span class="rb-secundarias">
      <button type="button" data-action="retirada"><i class="fa-solid fa-person-walking-arrow-right"></i> Retirada</button>
      <button type="button" data-action="grieta"><i class="fa-solid fa-bolt-lightning"></i> Seguir la Grieta</button>
      <button type="button" data-action="limpiar"><i class="fa-solid fa-eraser"></i> Limpiar</button>
    </span>
  </footer>
  {{/if}}
</div>
