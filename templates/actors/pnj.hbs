<form class="rb-sheet" autocomplete="off">
  <header class="rb-cabecera rb-oscuro">
    <div class="rb-retrato-marco">
      <img class="rb-retrato" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    </div>
    <div>
      <input class="rb-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre">
      <input class="rb-concepto" type="text" name="system.rol" value="{{system.rol}}" placeholder="Rol en el caso">
    </div>
  </header>

  <section class="rb-cuerpo">
    <section class="rb-papel">
      <h2>Persona de interés</h2>
      <p class="rb-ayuda-fuerte">Un secreto no equivale a culpabilidad. No decidas antes de la Revelación.</p>
      <div class="rb-lista-campos" style="gap:.6rem;margin-top:.6rem">
        <div><label>Qué quiere</label><textarea name="system.quiere" rows="2">{{system.quiere}}</textarea></div>
        <div><label>Qué oculta</label><textarea name="system.oculta" rows="2">{{system.oculta}}</textarea></div>
        <div><label>Cómo reacciona bajo presión</label><textarea name="system.bajoPresion" rows="2">{{system.bajoPresion}}</textarea></div>
      </div>
    </section>
    <section class="rb-papel" style="margin-top:.9rem">
      <h2>Notas</h2>
      {{editor notasHTML target="system.notas" button=true editable=editable engine="prosemirror"}}
    </section>
  </section>
</form>
