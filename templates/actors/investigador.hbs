<form class="rb-sheet" autocomplete="off">

  <header class="rb-cabecera rb-oscuro">
    <div class="rb-retrato-marco">
      <img class="rb-retrato" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
      <span class="rb-retrato-pie">{{system.pronombres}}</span>
    </div>
    <div>
      <input class="rb-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre">
      <input class="rb-concepto" type="text" name="system.concepto" value="{{system.concepto}}"
             placeholder="Una frase: quién eres y qué clase de problemas sueles resolver">
      <div class="rb-cabecera-fila">
        <div><label>Pronombres</label><input type="text" name="system.pronombres" value="{{system.pronombres}}"></div>
        <div><label>Profesión</label>
          <select name="system.profesion"><option value="">—</option>
            {{#each profesiones}}<option value="{{this}}" {{#if (eq this ../system.profesion)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select></div>
        <div><label>Kit</label>
          <select name="system.kit"><option value="">—</option>
            {{#each kits}}<option value="{{this}}" {{#if (eq this ../system.kit)}}selected{{/if}}>{{this}}</option>{{/each}}
          </select></div>
      </div>
    </div>
    <div class="rb-cabecera-acciones">
      <button type="button" data-rb="muro"><i class="fa-solid fa-diagram-project"></i> Muro</button>
      <button type="button" data-rb="revelacion"><i class="fa-solid fa-bullseye"></i> Revelar</button>
    </div>
  </header>

  <nav class="rb-tabs">
    <a class="item" data-tab="ficha">Ficha</a>
    <a class="item" data-tab="presion">Presión</a>
    <a class="item" data-tab="notas">Notas</a>
  </nav>

  <section class="rb-sheet-body rb-cuerpo">

    <div class="tab" data-tab="ficha">
      <section class="rb-papel rb-ancho" style="margin-bottom:1.1rem">
        <h2>Los cuatro Métodos</h2>
        <p class="rb-ayuda">2d6 más un d6 por punto de Método; conserva los dos mejores. Un 0 no significa incompetencia.
          {{#unless repartoValido}}<span class="rb-aviso">El reparto debería ser 2, 1, 1 y 0.</span>{{/unless}}</p>
        <div class="rb-metodos">
          {{#each metodos}}
          <div>
            <button type="button" class="rb-metodo {{#unless valor}}rb-cero{{/unless}}" data-rb="tirar" data-metodo="{{clave}}"
                    title="Tirar {{etiqueta}}">
              <span class="rb-metodo-nombre">{{etiqueta}}</span>
              <span class="rb-metodo-valor">{{valor}}</span>
              <span class="rb-metodo-dados">{{dados}}d6kh2</span>
            </button>
            <div class="rb-metodo-ajuste">
              <button type="button" data-rb="metodo-menos" data-metodo="{{clave}}">−</button>
              <input type="number" name="system.metodos.{{clave}}" value="{{valor}}" min="0" max="3">
              <button type="button" data-rb="metodo-mas" data-metodo="{{clave}}">+</button>
            </div>
          </div>
          {{/each}}
        </div>
      </section>

      <div class="rb-rejilla">
        <section class="rb-papel">
          <h2>Especialidades</h2>
          <p class="rb-ayuda">Formación real. No añaden dados: permiten lectura experta y justifican Ventaja.</p>
          <div class="rb-lista-campos">
            <input type="text" name="system.especialidades.c1" value="{{system.especialidades.c1}}" placeholder="Especialidad 1">
            <input type="text" name="system.especialidades.c2" value="{{system.especialidades.c2}}" placeholder="Especialidad 2">
          </div>
        </section>

        <section class="rb-papel">
          <h2>Talento</h2>
          <select class="rb-talento-elegir">
            <option value="">— elegir de la lista —</option>
            {{#each talentos}}<option value="{{id}}" {{#if (eq nombre ../system.talento.nombre)}}selected{{/if}}>{{nombre}}</option>{{/each}}
          </select>
          <input type="text" name="system.talento.nombre" value="{{system.talento.nombre}}" placeholder="Nombre del Talento">
          <p class="rb-talento-regla">{{#if system.talento.regla}}{{system.talento.regla}}{{else}}Los Talentos conceden preguntas, permisos o excepciones concretas; nunca bonificadores.{{/if}}</p>
          <div class="rb-usos">
            <label style="margin:0">Usos</label>
            {{#each usosTalento}}
            <button type="button" class="rb-uso {{#if gastado}}gastado{{/if}}" data-rb="uso-talento" data-n="{{n}}" title="Uso {{n}}"></button>
            {{/each}}
            <button type="button" style="margin-left:auto" data-rb="usar-talento" {{disabled (not talentoDisponible)}}>Usar</button>
          </div>
        </section>

        <section class="rb-papel rb-ancho">
          <h2>Obsesión, Punto Ciego y Vínculo</h2>
          <div class="rb-rejilla" style="gap:.8rem">
            <div><label>Obsesión</label><textarea name="system.obsesion" rows="2"
              placeholder="Qué pregunta, injusticia o patrón te impide dejar el caso">{{system.obsesion}}</textarea></div>
            <div><label>Punto Ciego</label><textarea name="system.puntoCiego" rows="2"
              placeholder="Cómo interpretas mal a personas o situaciones">{{system.puntoCiego}}</textarea></div>
            <div class="rb-ancho"><label>Vínculo</label><textarea name="system.vinculo" rows="2"
              placeholder="Una frase sobre otro investigador: qué le debes o por qué confías —o no— en su criterio">{{system.vinculo}}</textarea></div>
          </div>
        </section>
      </div>
    </div>

    <div class="tab" data-tab="presion">
      <div class="rb-rejilla">
        <section class="rb-papel">
          <h2>Tensión</h2>
          <p class="rb-ayuda">Cuánto de ti mismo estás gastando para seguir funcionando. No penaliza tiradas por sí sola.</p>
          <div class="rb-tension-fila">
            {{#each tensionCasillas}}
            <button type="button" class="rb-casilla {{#if marcada}}marcada{{/if}}" data-rb="tension" data-valor="{{n}}">
              <i class="fa-solid {{#if marcada}}fa-bolt{{else}}fa-square{{/if}}"></i></button>
            {{/each}}
            <span class="rb-tension-cuenta">{{system.tension.value}} / {{system.tension.max}}</span>
          </div>
          <div class="rb-fila-botones">
            <button type="button" data-rb="encajar"><i class="fa-solid fa-plus"></i> Encajar</button>
            <button type="button" data-rb="borrar-tension"><i class="fa-solid fa-minus"></i> Borrar</button>
          </div>
          {{#if enRiesgoDeRuptura}}<span class="rb-sello">Una marca más: Ruptura</span>{{/if}}
        </section>

        <section class="rb-papel">
          <h2>Condiciones</h2>
          <p class="rb-ayuda">Descriptores de ficción. Si afectan a una Acción, provocan Desventaja; si la hacen inverosímil, cambia de enfoque.</p>
          <div class="rb-lista-campos">
            {{#each condiciones}}
            <div class="rb-condicion">
              <input type="text" name="system.condiciones.{{slot}}" value="{{texto}}" placeholder="Condición {{n}}">
              <button type="button" class="rb-boton-icono" data-rb="quitar-condicion" data-slot="{{slot}}" title="La ficción lo permite"><i class="fa-solid fa-xmark"></i></button>
            </div>
            {{/each}}
          </div>
        </section>

        <section class="rb-papel">
          <h2>Secuelas</h2>
          <p class="rb-ayuda">Cuando aparece el Disparador: marca 1 Tensión para mantener el control, o acepta la complicación.</p>
          {{#each secuelas}}
          <div class="rb-secuela">
            <input type="text" name="system.secuelas.{{slot}}.nombre" value="{{nombre}}" placeholder="Nombre">
            <input type="text" name="system.secuelas.{{slot}}.disparador" value="{{disparador}}" placeholder="Disparador">
            <button type="button" data-rb="secuela" data-slot="{{slot}}" {{disabled (not nombre)}} title="Se dispara">
              <i class="fa-solid fa-burst"></i></button>
          </div>
          {{/each}}
        </section>

        <section class="rb-papel">
          <h2>Anclas personales</h2>
          <p class="rb-ayuda">Una escena breve y significativa con un Ancla borra 1 Tensión, una vez por sesión.</p>
          {{#each anclas}}
          <div class="rb-ancla-fila {{#if usada}}usada{{/if}}">
            <input type="text" name="system.anclas.{{slot}}.nombre" value="{{nombre}}"
                   placeholder="Persona, lugar, rutina o compromiso fuera del caso">
            <button type="button" data-rb="ancla" data-slot="{{slot}}" {{disabled (or usada (not nombre))}}>
              <i class="fa-solid {{#if usada}}fa-check{{else}}fa-anchor{{/if}}"></i> {{#if usada}}Usada{{else}}Jugar{{/if}}</button>
          </div>
          {{/each}}
        </section>
      </div>
    </div>

    <div class="tab" data-tab="notas">
      <section class="rb-papel">
        <h2>Notas</h2>
        {{editor notasHTML target="system.notas" button=true editable=editable engine="prosemirror"}}
      </section>
    </div>

  </section>
</form>
