<section class="rb-ruido">
  <h2>Ruido de Fondo</h2>
  <p class="rb-ayuda">Cuánto ha alterado vuestra presencia el entorno. Nunca sube solo porque pase tiempo.</p>
  <div class="rb-ruido-track">
    {{#each ruidoTrack}}
    <button type="button"
            class="rb-ruido-paso {{#if activo}}activo{{/if}} {{#if reaccion}}es-reaccion{{/if}} {{#if mayor}}es-mayor{{/if}}"
            data-action="fijarRuido" data-valor="{{n}}" {{disabled (not ../esGM)}}
            title="{{#if reaccion}}Reacción{{else if mayor}}Reacción Mayor{{/if}}">{{n}}</button>
    {{/each}}
  </div>
  <p class="rb-ruido-leyenda">
    <span class="rb-leyenda-3">3 · Reacción</span>
    <span class="rb-leyenda-6">6 · Reacción Mayor, después baja a 3</span>
  </p>
  {{#if enReaccionMayor}}
    {{#if esGM}}
    <button type="button" class="rb-boton-alerta" data-action="reaccionMayor">
      <i class="fa-solid fa-triangle-exclamation"></i> Resolver Reacción Mayor</button>
    {{/if}}
  {{/if}}
</section>
