<article class="rb-tarjeta rb-tarjeta-pista {{#if dura}}dura{{/if}} {{#unless descubierta}}oculta{{/unless}}" data-id="{{id}}">
  <header>
    <span class="rb-tarjeta-codigo">{{#if codigo}}{{codigo}}{{else}}—{{/if}}</span>
    <h3>{{nombre}}</h3>
    {{#if dura}}<span class="rb-badge rb-badge-dura">DURA</span>{{/if}}
  </header>
  <p class="rb-tarjeta-texto">{{texto}}</p>
  {{#if contexto}}<p class="rb-tarjeta-contexto">{{contexto}}</p>{{/if}}
  {{#if fiabilidad}}<p class="rb-tarjeta-fiabilidad"><i class="fa-solid fa-circle-half-stroke"></i> {{fiabilidad}}</p>{{/if}}
  <footer>
    {{#if lugar}}<span class="rb-tarjeta-lugar"><i class="fa-solid fa-location-dot"></i> {{lugar}}</span>{{/if}}
    <span class="rb-tarjeta-acciones">
      {{#if esGM}}
      <button type="button" data-action="alternarDescubierta" title="Descubierta por la mesa">
        <i class="fa-solid {{#if descubierta}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
      {{/if}}
      <button type="button" data-action="abrirDoc" title="Abrir"><i class="fa-solid fa-pen"></i></button>
      {{#if esGM}}
      <button type="button" data-action="borrarDoc" title="Borrar"><i class="fa-solid fa-trash"></i></button>
      {{/if}}
    </span>
  </footer>
</article>
